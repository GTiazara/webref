---
import { getCollection } from 'astro:content';
import { ArrowDown, ArrowRight, ArrowUpRight, Blocks, Check, Compass, ExternalLink, Globe, Search, Sparkles } from '@lucide/astro';
import '../styles/global.css';

const resources = (await getCollection('resources')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr'));
const categories = [...new Set(resources.map(({ data }) => data.category))].sort((a, b) => a.localeCompare(b, 'fr'));
const categoryColors = ['peach', 'blue', 'green', 'yellow', 'lilac', 'pink', 'mint', 'orange'];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Une collection de sites et d'outils utiles, rangés par catégorie." />
    <meta name="theme-color" content="#f8f8f5" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>WebRéférences | Les bons liens, au bon endroit</title>
  </head>
  <body>
    <header class="header">
      <div class="shell header-inner">
        <a class="brand" href={import.meta.env.BASE_URL} aria-label="WebRéférences, accueil">
          <span class="brand-mark"><Compass size={22} stroke-width={2.2} /></span>
          <span>web<span class="brand-accent">références</span><small>La petite collection du web</small></span>
        </a>
        <nav class="main-nav" aria-label="Navigation principale">
          <a class="nav-active" href="#accueil">Accueil</a><a href="#categories">Catégories</a><a href="#ressources">La collection</a>
        </nav>
        <a class="header-link" href="#ressources">Explorer les liens <ArrowRight size={16} /></a>
      </div>
    </header>
    <main id="accueil">
      <section class="hero shell">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> VOTRE COIN DU WEB</div>
          <h1>Les bons liens,<br />au <em>bon endroit.</em></h1>
          <p>Des sites et des outils utiles, soigneusement rangés pour les retrouver au moment où vous en avez besoin.</p>
          <div class="hero-actions"><a class="button-primary" href="#ressources">Explorer la collection <ArrowDown size={17} /></a><span><span class="hero-count">{resources.length}</span> ressources à découvrir</span></div>
        </div>
      </section>
      <section class="category-section" id="categories">
        <div class="shell category-inner">
          <div class="category-heading"><span class="section-number">01 / EXPLORER</span><h2>Par où commencer ?</h2><p>Une catégorie, et c'est parti.</p></div>
          <div class="category-list" aria-label="Catégories">{categories.map((category, index) => <button type="button" class="category-tile" data-category-shortcut={category}><span class:list={['category-icon', categoryColors[index % categoryColors.length]]}><Blocks size={20} /></span><span><strong>{category}</strong><small>{resources.filter(({ data }) => data.category === category).length} ressources</small></span><ArrowUpRight class="tile-arrow" size={17} /></button>)}</div>
        </div>
      </section>
      <section class="collection shell" id="ressources">
        <div class="collection-heading"><div><span class="section-number">02 / LA COLLECTION</span><h2>Les bonnes adresses<span class="heading-dot">.</span></h2><p>À explorer, à utiliser, à garder sous le coude.</p></div><div class="collection-note"><Sparkles size={18} /> Une sélection pour vous simplifier le web</div></div>
        <div class="toolbar">
          <div class="filters" aria-label="Filtrer par catégorie"><button type="button" class="filter active" data-filter="all" aria-pressed="true">Tout voir <span>{resources.length}</span></button>{categories.map((category) => <button type="button" class="filter" data-filter={category} aria-pressed="false">{category}</button>)}</div>
          <label class="search-box"><Search size={18} /><span class="sr-only">Rechercher une ressource</span><input id="resource-search" type="search" placeholder="Rechercher un site, un outil..." /></label>
        </div>
        <div class="result-line"><p id="result-count" aria-live="polite">{resources.length} ressources</p><span>UNE COLLECTION QUI GRANDIT AVEC VOUS <ArrowRight size={14} /></span></div>
        <div class="resource-grid" id="resource-grid">
          {resources.map(({ data }) => {
            const domain = new URL(data.url).hostname.replace(/^www\./, '');
            const color = categoryColors[categories.indexOf(data.category) % categoryColors.length];
            return <article class="resource-card" data-category={data.category} data-search={`${data.title} ${data.description} ${data.category} ${data.tags.join(' ')} ${domain}`}>
              <div class="card-top"><span class:list={['resource-icon', color]}><img src={`https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`} alt="" loading="lazy" /><span>{data.title.charAt(0)}</span></span><a class="external-icon" href={data.url} target="_blank" rel="noopener noreferrer" aria-label={`Ouvrir ${data.title} dans un nouvel onglet`} title={`Ouvrir ${data.title}`}><ArrowUpRight size={19} /></a></div>
              <div class="card-content"><span class="card-category">{data.category}</span><h3><a href={data.url} target="_blank" rel="noopener noreferrer">{data.title}</a></h3><p>{data.description}</p></div>
              <div class="card-bottom"><span><Globe size={14} /> {domain}</span><span class="visit-link">Visiter <ExternalLink size={14} /></span></div>
            </article>;
          })}
        </div>
        <div class="empty-state" id="empty-state" hidden><Search size={24} /><h3>Aucun résultat</h3><p>Essayez un autre mot-clé ou une autre catégorie.</p><button type="button" id="reset-filters">Effacer les filtres</button></div>
      </section>
      <section class="closing shell"><div class="closing-icon"><Check size={23} /></div><div><span>MOINS DE RECHERCHES, PLUS DE TROUVAILLES</span><h2>Le web est vaste. Gardons le meilleur.</h2></div><a href="#accueil">Retour en haut <ArrowUpRight size={16} /></a></section>
    </main>
    <footer><div class="shell footer-inner"><a class="footer-brand" href="#accueil"><span class="brand-mark"><Compass size={19} /></span> web<span>références</span></a><p>Une collection de liens utiles, tout simplement.</p><span>Fait pour les curieux <span class="footer-heart">♥</span></span></div></footer>
    <script>
      const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const shortcuts = document.querySelectorAll<HTMLButtonElement>('[data-category-shortcut]');
      const cards = document.querySelectorAll<HTMLElement>('.resource-card');
      const search = document.querySelector<HTMLInputElement>('#resource-search');
      const count = document.querySelector<HTMLElement>('#result-count');
      const empty = document.querySelector<HTMLElement>('#empty-state');
      const reset = document.querySelector<HTMLButtonElement>('#reset-filters');
      let selectedCategory = 'all';

      function normalize(value: string): string {
        return value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
      }

      function updateResults(): void {
        const query = normalize(search?.value ?? '');
        let visible = 0;
        cards.forEach((card) => {
          const matchesCategory = selectedCategory === 'all' || card.dataset.category === selectedCategory;
          card.hidden = !matchesCategory || !normalize(card.dataset.search ?? '').includes(query);
          if (!card.hidden) visible += 1;
        });
        filters.forEach((filter) => {
          const active = filter.dataset.filter === selectedCategory;
          filter.classList.toggle('active', active);
          filter.setAttribute('aria-pressed', String(active));
        });
        if (count) count.textContent = `${visible} ressource${visible === 1 ? '' : 's'}`;
        if (empty) empty.hidden = visible !== 0;
      }

      filters.forEach((filter) => filter.addEventListener('click', () => { selectedCategory = filter.dataset.filter ?? 'all'; updateResults(); }));
      shortcuts.forEach((shortcut) => shortcut.addEventListener('click', () => {
        selectedCategory = shortcut.dataset.categoryShortcut ?? 'all';
        if (search) search.value = '';
        updateResults();
        document.querySelector('#ressources')?.scrollIntoView({ behavior: 'smooth' });
      }));
      search?.addEventListener('input', updateResults);
      reset?.addEventListener('click', () => { selectedCategory = 'all'; if (search) search.value = ''; updateResults(); search?.focus(); });
    </script>
  </body>
</html>